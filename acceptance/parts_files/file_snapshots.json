{
  "covers": {"nx_create_snapshot": [], "nx_list_snapshots": [], "nx_restore_snapshot": []},
  "fixture": "fixtures/parts_files_block_mm.prt",
  "part": null,
  "steps": [
    {"call": "nx_create_part", "setup": true, "save": "made", "args": {"path": "$run/snap/pf_snap_made.prt"}},
    {"call": "nx_save_part", "setup": true, "args": {"part": "pf_snap_made"}},
    {"call": "nx_create_snapshot", "save": "s1", "args": {"path": "$run/snap/pf_snap_made.prt", "note": "acceptance"},
     "intent": "Acceptance: a saved part file is copied into a snapshot",
     "expect": {"mutation_outcome": "committed", "data.snapshot.note": "acceptance",
                "data.snapshot.size": {"matches": "^[1-9][0-9]*$"},
                "data.snapshot.snapshot_id": {"matches": "^snap_[a-f0-9]{12}$"},
                "data.snapshot.source": {"matches": "/snap/pf_snap_made[.]prt$"}}},
    {"call": "nx_list_snapshots", "args": {"path": "$s1.data.snapshot.source"},
     "expect": {"page.total": 1, "data.items.0.snapshot_id": "$s1.data.snapshot.snapshot_id"}},
    {"call": "nx_restore_snapshot", "args": {"snapshot_id": "$s1.data.snapshot.snapshot_id", "overwrite": true},
     "intent": "Acceptance: the file of a loaded part is never overwritten",
     "expect": {"error.code": "NX_PART_IN_USE", "mutation_outcome": "not_started"}},
    {"call": "nx_restore_snapshot", "args": {"snapshot_id": "$s1.data.snapshot.snapshot_id", "to": "$run/snap/pf_snap_copy.prt"},
     "intent": "Acceptance: a snapshot is restored to a new file with the snapshot's checksum",
     "expect": {"mutation_outcome": "committed", "data.overwritten": false,
                "data.sha256": "$s1.data.snapshot.sha256"}},
    {"call": "nx_close_part", "setup": true, "args": {"part": "$made.data.part.id", "save": false}},
    {"call": "nx_restore_snapshot", "args": {"snapshot_id": "$s1.data.snapshot.snapshot_id", "overwrite": true},
     "intent": "Acceptance: once closed, the original is overwritten after a safety snapshot",
     "expect": {"mutation_outcome": "committed", "data.overwritten": true,
                "data.safety_snapshot_id": {"matches": "^snap_[a-f0-9]{12}$"}}},
    {"call": "nx_open_part", "save": "back", "args": {"path": "$run/snap/pf_snap_made.prt"},
     "intent": "Acceptance: NX opens the restored part file",
     "expect": {"data.part.id": {"matches": "."}}},
    {"call": "nx_close_part", "setup": true, "args": {"part": "$back.data.part.id", "save": false}},
    {"call": "nx_restore_snapshot", "args": {"snapshot_id": "$s1.data.snapshot.snapshot_id", "overwrite": true, "to": "$run/snap/x.prt"},
     "expect": {"error.code": "NX_INVALID_ARGUMENT", "mutation_outcome": "not_started"}},
    {"call": "nx_create_snapshot", "setup": true, "save": "fx", "args": {"path": "$fixture"}},
    {"call": "nx_restore_snapshot", "args": {"snapshot_id": "$fx.data.snapshot.snapshot_id", "overwrite": true},
     "intent": "Acceptance: a file no NX MCP tool wrote (the copied fixture) is never overwritten",
     "expect": {"error.code": "NX_READ_ONLY", "error.field": "/overwrite", "mutation_outcome": "not_started"}}
  ]
}
