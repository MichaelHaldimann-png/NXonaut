{
  "covers": {"nx_create_joint": ["revolute", "cylindrical", "slider", "fixed"]},
  "fixture": null,
  "part": "new",
  "steps": [
    {"call": "nx_create_part", "setup": true, "args": {"path": "$run/jt/jt_pin.prt", "units": "mm"}},
    {"call": "nx_create_sketch", "setup": true, "save": "sk", "args": {"placement": {"principal": "xy"}}},
    {"call": "nx_create_sketch_curves", "setup": true, "args": {"sketch": "$sk.data.sketch.id", "curves": [{"type": "circle", "center": [0, 0], "radius": 5}]}},
    {"call": "nx_finish_sketch", "setup": true, "args": {"sketch": "$sk.data.sketch.id"}},
    {"call": "nx_create_extrude", "setup": true, "args": {"sketch": "$sk.data.sketch.id", "end": {"type": "distance", "value": 20}}},
    {"call": "nx_save_part", "setup": true, "args": {}},
    {"call": "nx_create_part", "setup": true, "args": {"path": "$part", "units": "mm"}},
    {"call": "nx_create_component", "setup": true, "save": "A", "args": {"part": "$part", "path": "$run/jt/jt_pin.prt", "name": "A"}},
    {"call": "nx_create_component", "setup": true, "save": "B", "args": {"part": "$part", "path": "$run/jt/jt_pin.prt", "name": "B", "pose": {"translation": [30, 0, 0]}}},
    {"call": "nx_create_component", "setup": true, "save": "C", "args": {"part": "$part", "path": "$run/jt/jt_pin.prt", "name": "C", "pose": {"translation": [0, 40, 0]}}},
    {"call": "nx_create_component", "setup": true, "save": "D", "args": {"part": "$part", "path": "$run/jt/jt_pin.prt", "name": "D", "pose": {"translation": [40, 40, 0]}}},
    {"call": "nx_create_assembly_constraint", "setup": true, "args": {"part": "$part", "type": "fix", "component": "$A.data.component.id"}},
    {"call": "nx_find_geometry", "setup": true, "save": "Atop", "args": {"owner": "$A.data.component.id", "kind": "edge", "geometry_type": "circle", "near": [5, 0, 20], "limit": 1}},
    {"call": "nx_find_geometry", "setup": true, "save": "Bbot", "args": {"owner": "$B.data.component.id", "kind": "edge", "geometry_type": "circle", "near": [35, 0, 0], "limit": 1}},
    {"call": "nx_create_joint",
     "args": {"part": "$part", "type": "revolute", "component": "$B.data.component.id", "target_component": "$A.data.component.id",
              "axis": "$Bbot.data.items.0.id", "target_axis": "$Atop.data.items.0.id"},
     "expect": {"mutation_outcome": "committed", "data.freedom": "rotation about the axis",
                "data.constraints.0.type": "concentric", "data.constraints.0.status": "Solved"}},
    {"call": "nx_find_geometry", "setup": true, "save": "Acyl", "args": {"owner": "$A.data.component.id", "kind": "face", "geometry_type": "cylinder", "limit": 1}},
    {"call": "nx_find_geometry", "setup": true, "save": "Ccyl", "args": {"owner": "$C.data.component.id", "kind": "face", "geometry_type": "cylinder", "limit": 1}},
    {"call": "nx_create_joint",
     "args": {"part": "$part", "type": "cylindrical", "component": "$C.data.component.id", "target_component": "$A.data.component.id",
              "axis": "$Ccyl.data.items.0.id", "target_axis": "$Acyl.data.items.0.id"},
     "expect": {"mutation_outcome": "committed", "data.constraints.0.type": "align", "data.constraints.0.status": "Solved"}},
    {"call": "nx_find_geometry", "setup": true, "save": "Dcyl", "args": {"owner": "$D.data.component.id", "kind": "face", "geometry_type": "cylinder", "limit": 1}},
    {"call": "nx_create_joint",
     "args": {"part": "$part", "type": "slider", "component": "$D.data.component.id", "target_component": "$A.data.component.id",
              "axis": "$Dcyl.data.items.0.id", "target_axis": "$Acyl.data.items.0.id"},
     "save": "slide",
     "expect": {"mutation_outcome": "committed", "data.constraints.0.type": "align_lock", "data.constraints.0.status": "Solved"}},
    {"call": "nx_undo_operation", "args": {"part": "$part", "operation": "$slide.operation_id"}, "intent": "Acceptance: undo the slider joint"},
    {"call": "nx_create_joint",
     "args": {"part": "$part", "type": "fixed", "component": "$D.data.component.id", "target_component": "$A.data.component.id"},
     "expect": {"mutation_outcome": "committed", "data.freedom": "none", "data.constraints.0.type": "bond"}},
    {"call": "nx_list_assembly_constraints", "args": {"part": "$part"},
     "expect": {"data.counts.free": 0, "data.counts.unsolved": 0}}
  ]
}
