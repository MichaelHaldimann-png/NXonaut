{
  "covers": {"nx_get_bill_of_materials": [], "nx_export_bill_of_materials": []},
  "fixture": null,
  "part": "new",
  "steps": [
    {"call": "nx_create_part", "setup": true, "args": {"path": "$run/bom_plate.prt", "units": "mm"}},
    {"call": "nx_create_primitive", "setup": true, "save": "plate",
     "args": {"part": "bom_plate", "length": 100, "width": 60, "height": 10}},
    {"call": "nx_set_material", "setup": true,
     "args": {"part": "bom_plate", "bodies": ["$plate.data.bodies.0.id"],
              "material": {"custom": {"name": "BOM_STEEL", "density": 7850}}}},
    {"call": "nx_save_part", "setup": true, "args": {"part": "bom_plate"}},
    {"call": "nx_create_part", "setup": true, "args": {"path": "$run/bom_pin.prt", "units": "mm"}},
    {"call": "nx_create_primitive", "setup": true,
     "args": {"part": "bom_pin", "shape": "cylinder", "diameter": 8, "height": 30}},
    {"call": "nx_save_part", "setup": true, "args": {"part": "bom_pin"}},
    {"call": "nx_create_part", "setup": true, "args": {"path": "$part", "units": "mm"}},
    {"call": "nx_create_component", "setup": true,
     "args": {"part": "$part", "path": "$run/bom_plate.prt", "name": "PLATE"}},
    {"call": "nx_create_component", "setup": true,
     "args": {"part": "$part", "path": "$run/bom_pin.prt", "name": "PIN_1", "pose": {"translation": [20, 20, 10]}}},
    {"call": "nx_create_component", "setup": true,
     "args": {"part": "$part", "path": "$run/bom_pin.prt", "name": "PIN_2", "pose": {"translation": [80, 20, 10]}}},
    {"call": "nx_create_component", "setup": true, "save": "spare",
     "args": {"part": "$part", "path": "$run/bom_pin.prt", "name": "SPARE", "pose": {"translation": [50, 100, 0]}}},
    {"call": "nx_edit_component", "setup": true,
     "args": {"part": "$part", "components": ["$spare.data.component.id"], "suppressed": true}},
    {"call": "nx_get_bill_of_materials", "args": {"part": "$part"},
     "expect": {"data.row_count": 2, "data.total_quantity": 3, "data.skipped": 1,
                "data.rows.0.item": "1", "data.rows.0.quantity": 1, "data.rows.0.material": "BOM_STEEL",
                "data.rows.0.name": {"matches": "(?i)^bom_plate$"},
                "data.rows.1.item": "2", "data.rows.1.quantity": 2, "data.rows.1.loaded": true}},
    {"call": "nx_get_bill_of_materials", "args": {"part": "$part", "structure": "indented", "include_suppressed": true},
     "expect": {"data.total_quantity": 4, "data.skipped": 0, "data.rows.1.quantity": 3, "data.rows.1.level": 0}},
    {"call": "nx_export_bill_of_materials",
     "args": {"part": "$part", "path": "$run/bom.csv", "structure": "top_level"},
     "expect": {"mutation_outcome": "committed", "data.row_count": 2, "data.total_quantity": 3,
                "data.path": {"matches": "bom[.]csv$"}}},
    {"call": "nx_export_bill_of_materials",
     "args": {"part": "$part", "path": "$run/bom.csv"},
     "expect": {"error.code": "NX_ALREADY_EXISTS", "mutation_outcome": "not_started"}}
  ]
}
